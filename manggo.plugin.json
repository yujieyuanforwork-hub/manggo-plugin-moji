{
  "manifestVersion": 1,
  "id": "io.github.yujieyuanforwork-hub.moji-dict",
  "name": "MOJi辞書",
  "version": "1.1.0",
  "description": "使用 MOJi辞書 公开接口的日语词典插件，无需配置即可查询词条、读音、义项、例句和文法条目，并朗读词条发音。",
  "author": "yujieyuan",
  "homepage": "https://github.com/yujieyuanforwork-hub/moji",
  "icon": "icon.png",
  "permissions": [
    "network"
  ],
  "runtime": {
    "kind": "bun",
    "api": "manggo.plugin.v1",
    "main": "main.js"
  },
  "services": [
    {
      "id": "dictionary",
      "providerId": "io.github.yujieyuanforwork-hub.moji-dict.dictionary",
      "kind": "translation",
      "resultType": "dictionary",
      "displayName": "MOJi辞書",
      "entry": "translate",
      "main": "main.js",
      "icon": "icon.png",
      "permissions": [
        "network"
      ],
      "language": {
        "auto": "auto",
        "ja_JP": "ja",
        "zh_CN": "zh",
        "zh_TW": "zh"
      },
      "config": [
        {
          "key": "detailedLookup",
          "label": "查询词条详情",
          "control": "boolean",
          "default": true,
          "description": "开启后额外请求词条详情，返回读音、词性、分义项和配套例句；关闭后只使用搜索摘要，速度更快。"
        },
        {
          "key": "pronunciationAudio",
          "label": "获取发音音频",
          "control": "boolean",
          "default": true,
          "description": "开启后请求 MOJi 的词条发音地址，可在结果中直接朗读。"
        },
        {
          "key": "includeGrammar",
          "label": "包含文法条目",
          "control": "boolean",
          "default": true,
          "description": "把 MOJi 的文法搜索结果作为独立义项展示。"
        },
        {
          "key": "includeExamples",
          "label": "包含例句搜索结果",
          "control": "boolean",
          "default": true,
          "description": "把 MOJi 的例句搜索结果作为“例文”义项展示。"
        },
        {
          "key": "maxExamples",
          "label": "每个义项的例句数量",
          "control": "integer",
          "default": 3,
          "description": "限制单个义项展示的例句条数，取值范围 0 到 20。"
        },
        {
          "key": "maxRelatedWords",
          "label": "相关词条数量",
          "control": "integer",
          "default": 4,
          "description": "把其余搜索结果作为“相关词条”属性展示，取值范围 0 到 20。"
        }
      ]
    },
    {
      "id": "speech",
      "providerId": "io.github.yujieyuanforwork-hub.moji-dict.speech",
      "kind": "speech",
      "displayName": "MOJi辞書 发音",
      "entry": "tts",
      "main": "main.js",
      "icon": "icon.png",
      "permissions": [
        "network"
      ],
      "language": {
        "auto": "auto",
        "ja_JP": "ja"
      },
      "config": [
        {
          "key": "strictMatch",
          "label": "仅朗读精确匹配的词条",
          "control": "boolean",
          "default": true,
          "description": "MOJi 只为词典收录的词条提供录音。开启后，词形或读音不完全一致时直接报错；关闭后会朗读搜索到的第一个词条。"
        },
        {
          "key": "maxLength",
          "label": "最大朗读长度",
          "control": "integer",
          "default": 32,
          "description": "超过该长度的文本直接报错，避免对整句发起无意义的查询。取值范围 1 到 200。"
        }
      ]
    },
    {
      "id": "open-in-moji",
      "kind": "action",
      "displayName": "在 MOJi辞書 中查询",
      "iconName": "menu_book",
      "entry": "openInMoji",
      "precheck": "canOpenInMoji",
      "main": "main.js",
      "enabledByDefault": true,
      "config": [
        {
          "key": "maxLength",
          "label": "最大选区长度",
          "control": "integer",
          "default": 32,
          "description": "选中文本超过该长度时不显示此动作。"
        },
        {
          "key": "japaneseOnly",
          "label": "仅日语选区显示",
          "control": "boolean",
          "default": false,
          "description": "开启后只在选区包含假名或汉字时显示此动作。"
        }
      ]
    }
  ]
}
